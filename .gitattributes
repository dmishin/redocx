# Normalize line endings: LF in the repository and in working copies on every OS.
* text=auto eol=lf

# Windows-only scripts keep CRLF.
*.cmd text eol=crlf
*.bat text eol=crlf
*.ps1 text eol=crlf

# Binary formats.
*.docx binary
*.dotx binary
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.zip  binary
