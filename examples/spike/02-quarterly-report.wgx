% alignment, generated includes, chart images, callout macro, two-column
% section, footnotes for sources, inline styles, theme colours.
% ============================================================================

\document[lang=en-US, smart-quotes=on]

\meta[
  title   = "Q3 2026 Operations Report",
  author  = "Finance & Operations",
  company = "Northwind Logistics",
]

\styles{
  defaults { font: "Aptos"; size: 10.5pt; space-after: 6pt; line-spacing: 1.1; }

  modify paragraph "Heading 1" { color: theme.accent1; size: 18pt; space-before: 18pt; }
  modify paragraph "Heading 2" { color: theme.accent1.darker(25%); size: 13pt; }

  paragraph "KPI Value" : Normal { size: 28pt; bold; color: theme.accent1; space-after: 0; align: center; }
  paragraph "KPI Label" : Normal { size: 9pt; color: theme.text1.lighter(35%); caps; align: center; }

  character "Positive" { color: #2E7D32; }
  character "Negative" { color: #C62828; }

  table "Fin Table" {
    borders: (top = single 1pt theme.text1, bottom = single 1pt theme.text1,
              inside-h = single 0.25pt #D0D0D0);
    cell-margins: (left=0.12cm, right=0.12cm, top=0.05cm, bottom=0.05cm);
    header-row { bold; border-bottom: single 0.75pt theme.text1; repeat; }
    last-row   { bold; border-top: single 0.75pt theme.text1; }
    banded-rows { odd { shading: theme.accent1.lighter(90%); } }
  }

  table "KPI Tiles" { borders: none; cell-margins: (all = 0.2cm); }
}

\define{callout}[title="Key takeaway"]{body}{
  \table[style="Callout", widths=(1fr), look=(no-banding)]{
    \row{\cell[shade=theme.accent1.lighter(85%), border-left=single 4pt theme.accent1]{
      \p[style="Callout Title"]{\title}
      \body
    }}
  }
}

\let{up}{\style{Positive}{▲}}
\let{down}{\style{Negative}{▼}}

\page[size=Letter, margins=(all=0.9in)]
\footer{Northwind Logistics · Q3 2026 Operations Report \tab \tab \pagenum}

\p[style="Title"]{Q3 2026 Operations Report}
\p[style="Subtitle"]{Prepared for the Board of Directors · October 2026}

% --- KPI tiles: a borderless 4-column layout table ---------------------------
\table[style="KPI Tiles", widths=(1fr, 1fr, 1fr, 1fr), align=center]{
  \row{
    \cell{\p[style="KPI Value"]{\$48.2M} \p[style="KPI Label"]{Revenue}}
    \cell{\p[style="KPI Value"]{94.1\%}  \p[style="KPI Label"]{On-time delivery}}
    \cell{\p[style="KPI Value"]{3.2\%}   \p[style="KPI Label"]{Damage rate}}
    \cell{\p[style="KPI Value"]{+12\%}   \p[style="KPI Label"]{Volume YoY}}
  }
}

= Executive Summary

Revenue reached \$48.2 million in Q3, up 9.4\% year over year \up, driven
by the new Rotterdam hub.\footnote{Revenue figures are unaudited and reported
in USD at the average quarterly exchange rate.} Operating margin declined to
11.8\% \down as fuel costs rose 22\% against Q2.

\callout{
  Volume growth is outpacing hub capacity. Without the Phase 2 expansion
  (@sec:capex), on-time delivery is projected to fall below the 92\% SLA
  threshold by Q1 2027.
}

