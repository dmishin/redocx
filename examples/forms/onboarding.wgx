% ============================================================================
% A fillable onboarding form: the M5 exit sample (comments and forms).
% Build: wordgenx build examples/forms/onboarding.wgx
% Word opens it protected for filling in: only the fields can be edited, and
% Track Changes is on for anyone who unprotects it to edit the text.
% ============================================================================

\document[lang=en-GB]
\meta[title="New Starter Onboarding", author="People Team"]
\settings[protection=(mode=forms, enforce), track-changes]
\styles{
  theme { accent1: #2F5496; }
  character "Form Label" { bold; size: 9pt; color: theme.accent1; }
  table "Form Grid" : "Table Grid" {
    borders: (outer=(single, 0.75pt, theme.accent1), inner=(single, 0.5pt, #BFBFBF));
    cell-margins: (top=0.08cm, bottom=0.08cm, left=0.15cm, right=0.15cm);
  }
}

\section[size=A4, margins=2cm]
\footer{\align[center]{\font[size=8pt]{People Team · Form HR-07 · Page \pagenum of \numpages}}}

\p[style=Title]{New Starter Onboarding}

Please fill in every field. The form is protected: only the grey fields can be edited.
\comment[author="R. Patel", date=2026-10-13, text={Shall we add the \b{emergency contact}
here, or keep it in the HR system only?}]{Return it to the People Team}
before your first day.

= About you

\table[style="Form Grid", widths=(5cm, 1fr)]{
  | \style["Form Label"]{Full name}    | \control[tag=name, title="Full name", placeholder="First and last name"] |
  | \style["Form Label"]{Preferred name} | \control[tag=preferred, title="Preferred name"] |
  | \style["Form Label"]{Department}   | \control[dropdown, tag=department, title=Department, items=("Engineering", "Operations", "Finance", "People")] |
  | \style["Form Label"]{Role}         | \control[combo, tag=role, title=Role, items=("Analyst", "Engineer", "Manager")] |
  | \style["Form Label"]{Start date}   | \control[date, tag=start, title="Start date", format="d MMMM yyyy"] |
  | \style["Form Label"]{Photo}        | \control[picture, tag=photo, title="Photo for your badge", width=3cm, height=4cm] |
}

= Equipment and access

\control[checkbox, tag=laptop] Laptop

\control[checkbox, tag=phone] Mobile phone

\control[checkbox, tag=parking] Parking permit

Anything else we should know?
\control[rich-text, tag=notes, title=Notes, placeholder="Accessibility needs, dietary requirements, ..."]

= Declaration

\control[checkbox, tag=handbook] I have read the staff handbook (version
\control[tag=version, lock=both]{2026.2}).

Signed: \control[tag=signature, title=Signature, placeholder="Type your name"]
\comment[author="R. Patel", date=2026-10-13, text="Legal asked whether a typed name is enough. Check before go-live."]
Date: \control[date, tag=signed, format="d MMM yyyy"]
