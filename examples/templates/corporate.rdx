% ============================================================================
% A corporate template, written in redocx and built as a Word template:
%   redocx build examples/templates/corporate.rdx -o examples/templates/corporate.dotx
% Documents use it with \document[template="templates/corporate.dotx"] or
%   redocx build doc.rdx --template examples/templates/corporate.dotx
% They get its styles, page setup, header and footer, and can still modify any style.
% ============================================================================

\document[lang=en-GB]

\styles{
  defaults { font: theme.minor; size: 10.5pt; space-after: 6pt; line-spacing: 1.1; }

  paragraph Title : Normal {
    font: theme.major; size: 28pt; color: theme.accent1.darker(25%); space-after: 12pt;
  }
  paragraph "Heading 1" : Normal {
    font: theme.major; size: 15pt; bold; color: theme.accent1.darker(25%);
    space-before: 18pt; space-after: 6pt; keep-with-next; keep-lines; outline-level: 1;
  }
  paragraph "Heading 2" : "Heading 1" { size: 12.5pt; space-before: 12pt; outline-level: 2; }

  numbering Headings {
    level 1 { text: "%1";    style: "Heading 1"; indent: 0.76cm hanging; }
    level 2 { text: "%1.%2"; style: "Heading 2"; indent: 1.02cm hanging; }
  }

  character Emphasis { italic; color: theme.accent1.darker(25%); }

  table "Corporate Table" : "Table Grid" {
    borders: (outer=(single, 0.75pt, theme.accent1.darker(25%)), inner=(single, 0.5pt, #BFBFBF));
    cell-margins: (left=0.15cm, right=0.15cm);
    space-after: 0pt;
    header-row { bold; color: #FFFFFF; shading: theme.accent1.darker(25%); repeat; }
    banded-rows { odd { shading: #F3F6FA; } }
  }
}

\section[size=A4, margins=(top=2.5cm, bottom=2.5cm, left=2.5cm, right=2.5cm), title-page]
\header[first]{\image[height=1.2cm]{../img/logo.png}}
\header{ACME Corporation \tab \tab \field{TITLE}}
\footer[first]{ACME Corporation · Confidential}
\footer{ACME Corporation · Confidential \tab \tab Page \pagenum of \numpages}
