% std:callout - highlighted boxes for notes, tips and warnings.
%
%   \use{std:callout}
%   \note{Plain information.}
%   \tip[title="Shortcut"]{Press F9 to update all fields.}
%   \warning{Refunds older than 180 days are rejected.}
%   \callout[title="Custom", shade=#EDE7F6]{Any colour.}
%
% A callout is a one-cell borderless table with a shaded background: Word users can
% edit it like any table. The title is bold and kept with the content.

\define{callout}[title="Note", shade=#E8F0FA]{
  \table[style=none, widths=(1fr)]{
    \row[cant-split]{\cell[shade=#shade]{
      \p[keep-with-next, space-after=3pt]{\b{#title}}

      #body
    }}
  }
}

\define{note}[title="Note"]{\callout[title=#title, shade=#E8F0FA]{#body}}
\define{tip}[title="Tip"]{\callout[title=#title, shade=#E6F4EA]{#body}}
\define{warning}[title="Warning"]{\callout[title=#title, shade=#FFF2CC]{#body}}
\define{caution}[title="Caution"]{\callout[title=#title, shade=#FBE3E4]{#body}}
