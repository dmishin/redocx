                              <w:pStyle w:val="PullQuote"/>
                            </w:pPr>
                            <w:r>
                              <w:t>“We used to read the road like yesterday’s newspaper. Now we read it like a weather radar.”</w:t>
                            </w:r>
                          </w:p>
                          <w:p>
                            <w:pPr>
                              <w:pStyle w:val="QuoteSource"/>
                            </w:pPr>
