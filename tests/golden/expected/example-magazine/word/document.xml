        </w:sectPr>
      </w:pPr>
      <w:r>
        <w:t>Ten sensors per kilometre · Waves that travel backwards · What comes next</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Kicker"/>
      </w:pPr>
      <w:r>
        <w:t>Feature</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Heading1"/>
      </w:pPr>
      <w:r>
        <w:t>Seeing the wave before it arrives</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Standfirst"/>
      </w:pPr>
      <w:r>
        <w:t>Loop detectors tell the city how fast traffic moves where they sit. Floating cars fill the gaps. Together they let the traffic centre see a jam forming minutes before drivers do.</w:t>
      </w:r>
    </w:p>
    <w:p>
