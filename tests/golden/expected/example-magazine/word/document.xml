      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="CoverLine"/>
      </w:pPr>
      <w:r>
        <w:t>The ring road learns to see its own traffic</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="CoverLine"/>
