      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>Events are signed with HMAC-SHA256. The receiver verifies the signature before parsing the body:</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="CodeBlock"/>
      </w:pPr>
      <w:r>
        <w:t>def verify(payload: bytes, header: str, secret: bytes) -&gt; bool:</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="CodeBlock"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">    expected = hmac.new(secret, payload, hashlib.sha256).hexdigest()</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="CodeBlock"/>
      </w:pPr>
      <w:r>
        <w:t xml:space="preserve">    return hmac.compare_digest(expected, header)</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Requirement"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:b/>
        </w:rPr>
        <w:t>[Must]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> The receiver shall reject events whose signature does not verify, and log them.</w:t>
      </w:r>
    </w:p>
