    <w:p>
      <w:r>
        <w:t>The checkout service never handles raw card numbers: card data is tokenised in the browser by the PayFlow SDK, and only tokens reach ACME systems.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Heading2"/>
      </w:pPr>
      <w:r>
        <w:t>Components</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="4"/>
        </w:numPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Strong"/>
        </w:rPr>
        <w:t>Checkout API</w:t>
      </w:r>
      <w:r>
        <w:t>: receives orders from the web shop and owns the order state.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="4"/>
        </w:numPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Strong"/>
        </w:rPr>
        <w:t>Payment Adapter</w:t>
      </w:r>
      <w:r>
        <w:t>: translates domain commands into PayFlow API calls. It is the only component holding gateway credentials.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="ListParagraph"/>
        <w:numPr>
          <w:ilvl w:val="0"/>
          <w:numId w:val="4"/>
        </w:numPr>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:rStyle w:val="Strong"/>
        </w:rPr>
        <w:t>Webhook Receiver</w:t>
      </w:r>
      <w:r>
        <w:t>: verifies and persists gateway events.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Heading2"/>
      </w:pPr>
      <w:r>
        <w:t>Error Handling</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t>Gateway errors are mapped to adapter behaviour in the appendix (app:errors).</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Heading1"/>
      </w:pPr>
      <w:r>
        <w:t>Functional Requirements</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Heading2"/>
      </w:pPr>
      <w:r>
        <w:t>Authorisation</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Requirement"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:b/>
        </w:rPr>
        <w:t>[Must]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> The adapter shall send amounts in minor currency units.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Requirement"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:b/>
        </w:rPr>
        <w:t>[Must]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> Every authorisation request shall carry an idempotency key.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Requirement"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:b/>
        </w:rPr>
        <w:t>[Should]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> The adapter should time out after 10 s and retry at most twice, reusing the idempotency key.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Heading2"/>
      </w:pPr>
      <w:r>
        <w:t>Refunds</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:pPr>
        <w:pStyle w:val="Requirement"/>
      </w:pPr>
      <w:r>
        <w:rPr>
          <w:b/>
        </w:rPr>
        <w:t>[Must]</w:t>
      </w:r>
      <w:r>
        <w:t xml:space="preserve"> Partial refunds shall be supported up to the captured amount.</w:t>
      </w:r>
    </w:p>
