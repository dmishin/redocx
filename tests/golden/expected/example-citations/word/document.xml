      <w:r>
        <w:t>Introduction</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t xml:space="preserve">Traffic flow is well described by kinematic wave models </w:t>
      </w:r>
      <w:hyperlink w:anchor="_Ref_bib_daganzo2005" w:history="1">
        <w:r>
          <w:t>(Daganzo, 2005)</w:t>
        </w:r>
      </w:hyperlink>
      <w:r>
        <w:t xml:space="preserve">. Shrinkage estimators were popularised by </w:t>
      </w:r>
      <w:hyperlink w:anchor="_Ref_bib_tibshirani1996" w:history="1">
        <w:r>
          <w:t>Tibshirani (1996)</w:t>
        </w:r>
      </w:hyperlink>
      <w:r>
        <w:t xml:space="preserve">; the proof of consistency is in </w:t>
      </w:r>
      <w:hyperlink w:anchor="_Ref_bib_tibshirani1996" w:history="1">
        <w:r>
          <w:t>(see Tibshirani, 1996, p. 214, Lemma 2)</w:t>
        </w:r>
      </w:hyperlink>
      <w:r>
        <w:t>.</w:t>
      </w:r>
    </w:p>
    <w:p>
      <w:r>
        <w:t xml:space="preserve">Several textbooks agree </w:t>
      </w:r>
      <w:hyperlink w:anchor="_Ref_bib_ortuzar2011" w:history="1">
        <w:r>
          <w:t>(Daganzo, 2005; Ortúzar and Willumsen, 2011)</w:t>
        </w:r>
      </w:hyperlink>
      <w:r>
        <w:t xml:space="preserve">, and the typesetting tradition goes back to </w:t>
      </w:r>
      <w:hyperlink w:anchor="_Ref_bib_knuth1984" w:history="1">
        <w:r>
          <w:t>Knuth (1984, p. 12)</w:t>
        </w:r>
      </w:hyperlink>
      <w:r>
        <w:t>.</w:t>
      </w:r>
    </w:p>
