% ============================================================================
% The wordgenx design documents as one book, built by wordgenx (the M2 exit).
%   python tools/md2wgx.py docs/0*.md --out docs/book/chapters
%   wordgenx build docs/book/template.wgx -o docs/book/wordgenx.dotx
%   wordgenx build docs/book/design.wgx
% ============================================================================

\document[template="wordgenx.dotx", lang=en-GB]

\meta[
  title    = "wordgenx: Design",
  subject  = "A markup language that compiles to Word documents",
  author   = "wordgenx contributors",
  keywords = (wordgenx, docx, design),
  custom.version = "M2",
]

\settings[update-fields-on-open=on]

% Front matter: roman page numbers, the title in the header (the cover keeps the
% template's logo header).
\section[page-numbers=lower-roman]
\header{\field{TITLE}}

% --- title page ----------------------------------------------------------------

\p[style=Title]{wordgenx}

\p[style=Subtitle]{Design: vision, language, architecture and roadmap}

\p[style="Title Meta"]{Version \field{DOCPROPERTY "version"} · \date[format="d MMMM yyyy"]}

\p[style="Title Meta"]{Written in Markdown, converted to wordgenx, and typeset by wordgenx itself.}

\pagebreak

\toc[levels=1-2, title="Contents"]

% --- the chapters ----------------------------------------------------------------
% A new section: pages from 1, and the current chapter in the header.

\section[page-numbers=(format=decimal, start=1)]
\header{\field{TITLE} \tab \tab \field{STYLEREF "Heading 1" \n} \field{STYLEREF "Heading 1"}}

\include{chapters/01-vision-and-scope.wgx}
\include{chapters/02-adr-implementation-language.wgx}
\include{chapters/03-language-design.wgx}
\include{chapters/04-architecture.wgx}
\include{chapters/05-feature-matrix.wgx}
\include{chapters/06-roadmap.wgx}
\include{chapters/07-testing-strategy.wgx}
\include{chapters/08-open-questions.wgx}
\include{chapters/09-postponed.wgx}
